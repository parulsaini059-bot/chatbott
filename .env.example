# ==============================================================================
# NovaAI - General-Purpose AI Assistant Configuration
# ==============================================================================

SECRET_KEY=nova-ai-secret-key-chatbott-983742
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///chatbot.db

# ------------------------------------------------------------------------------
# Real Large Language Model (LLM) Integration
# ------------------------------------------------------------------------------
# Default provider is Google Gemini ("gemini").
# Options: "gemini", "openai", "groq"
AI_PROVIDER=gemini

# 1. Google Gemini API (Recommended Default)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 2. OpenAI API
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Groq Cloud API (Ultra-fast Llama-3.3-70b inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
